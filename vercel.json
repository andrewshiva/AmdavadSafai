{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/guide",
      "destination": "/guide/index.html"
    },
    {
      "source": "/guide/",
      "destination": "/guide/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://amdavadsafai.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://amdavadsafai.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads|guide|assets|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
